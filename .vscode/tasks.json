{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "cmake configure",
      "type": "shell",
      "command": "cmake",
      "args": ["-S", ".", "-B", "build", "-DCMAKE_BUILD_TYPE=Debug"],
      "group": "build",
      "problemMatcher": ["$gcc"]
    },
    {
      "label": "cmake build",
      "type": "shell",
      "command": "cmake",
      "args": ["--build", "build", "--parallel", "${input:parallel}"],
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": ["$gcc"],
      "dependsOn": "cmake configure"
    },
    {
      "label": "run tests",
      "type": "shell",
      "command": "ctest",
      "args": ["--output-on-failure"],
      "options": { "cwd": "${workspaceFolder}/build" },
      "group": "test",
      "dependsOn": "cmake build"
    }
  ],
  "inputs": [
    {
      "id": "parallel",
      "type": "promptString",
      "description": "Number of parallel jobs",
      "default": "4"
    }
  ]
}
